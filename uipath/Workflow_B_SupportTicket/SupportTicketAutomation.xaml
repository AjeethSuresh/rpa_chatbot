<Activity mc:Ignorable="sap sap2010" x:Class="SupportTicketAutomation"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:scg="clr-namespace:System.Collections.Generic;assembly=mscorlib"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_TicketTitle" Type="InArgument(x:String)" />
    <x:Property Name="in_Category" Type="InArgument(x:String)" />
    <x:Property Name="in_Priority" Type="InArgument(x:String)" />
    <x:Property Name="in_Requester" Type="InArgument(x:String)" />
    <x:Property Name="in_Description" Type="InArgument(x:String)" />
    <x:Property Name="out_TicketId" Type="OutArgument(x:String)" />
    <x:Property Name="out_Status" Type="OutArgument(x:String)" />
  </x:Members>
  <Sequence DisplayName="ITSM Ticket Automation" sap:VirtualizedContainerService.HintSize="512,900">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="ticketReference" />
    </Sequence.Variables>
    <ui:LogMessage Level="Info" Message="[&quot;[AutoFlow AI] Launching ITSM Portal Automation for Title: &quot; + in_TicketTitle]" />
    <Assign DisplayName="Generate Incident Key">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[ticketReference]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">["INC-2026-" + System.Guid.NewGuid().ToString().Substring(0,5).ToUpper()]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:LogMessage Level="Info" Message="[&quot;Populating fields: Category=&quot; + in_Category + &quot;, Priority=&quot; + in_Priority + &quot;, Requester=&quot; + in_Requester]" />
    <Assign DisplayName="Return Ticket ID">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_TicketId]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[ticketReference]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Return Status">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_Status]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">["TICKET_CREATED"]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:LogMessage Level="Info" Message="[&quot;Successfully created support ticket: &quot; + ticketReference]" />
  </Sequence>
</Activity>
