<Activity mc:Ignorable="sap sap2010" x:Class="EmailProcessing"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:scg="clr-namespace:System.Collections.Generic;assembly=mscorlib"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_RequestId" Type="InArgument(x:String)" />
    <x:Property Name="in_EmailSender" Type="InArgument(x:String)" />
    <x:Property Name="in_AiAnswer" Type="InArgument(x:String)" />
    <x:Property Name="out_DraftId" Type="OutArgument(x:String)" />
    <x:Property Name="out_Status" Type="OutArgument(x:String)" />
  </x:Members>
  <Sequence DisplayName="AutoFlow Email Processing Workflow" sap:VirtualizedContainerService.HintSize="512,850">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="generatedDraftId" />
    </Sequence.Variables>
    <ui:LogMessage Level="Info" Message="[&quot;[AutoFlow AI] UiPath Robot starting Email Processing for Request: &quot; + in_RequestId]" />
    <Assign DisplayName="Assign Draft Identifier">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[generatedDraftId]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">["DRAFT-" + System.Guid.NewGuid().ToString().Substring(0,8).ToUpper()]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:LogMessage Level="Info" Message="[&quot;Preparing MailMessage draft addressed to: &quot; + in_EmailSender]" />
    <Assign DisplayName="Set Output Arguments">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_DraftId]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[generatedDraftId]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Set Status">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_Status]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">["DRAFT_CREATED"]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:LogMessage Level="Info" Message="[&quot;Email Draft created successfully with ID: &quot; + generatedDraftId]" />
  </Sequence>
</Activity>
