# AutoFlow AI Environment Configuration

# Core API Settings
APP_NAME="AutoFlow AI"
APP_ENV=development
PORT=8000
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=autoflow_ai

# LLM Providers
PRIMARY_LLM_PROVIDER=groq
SECONDARY_LLM_PROVIDER=gemini

# Groq API Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=2048

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Pinecone Vector DB Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=autoflow-knowledge-base
PINECONE_DIMENSION=768
PINECONE_METRIC=cosine
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.72

# UiPath Orchestrator & RPA Configuration
UIPATH_ENABLED=true
UIPATH_ORCHESTRATOR_URL=https://cloud.uipath.com/your-org/your-tenant/orchestrator_
UIPATH_CLIENT_ID=your_uipath_oauth_client_id
UIPATH_USER_KEY=your_uipath_user_key_or_secret
UIPATH_TENANT_NAME=Default
UIPATH_FOLDER_ID=12345
UIPATH_WEBHOOK_SECRET=uipath-webhook-signing-secret-here
UIPATH_LOCAL_MODE=true
