<Activity mc:Ignorable="sap sap2010" x:Class="InvoiceProcessingAutomation"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:scg="clr-namespace:System.Collections.Generic;assembly=mscorlib"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_InvoiceNumber" Type="InArgument(x:String)" />
    <x:Property Name="in_VendorName" Type="InArgument(x:String)" />
    <x:Property Name="in_TotalAmount" Type="InArgument(x:Double)" />
    <x:Property Name="in_ApprovalToken" Type="InArgument(x:String)" />
    <x:Property Name="in_ApprovedBy" Type="InArgument(x:String)" />
    <x:Property Name="out_VoucherNumber" Type="OutArgument(x:String)" />
    <x:Property Name="out_Status" Type="OutArgument(x:String)" />
  </x:Members>
  <Sequence DisplayName="ERP Invoice Processing Automation" sap:VirtualizedContainerService.HintSize="512,1000">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="voucherRef" />
    </Sequence.Variables>
    <ui:LogMessage Level="Info" Message="[&quot;[AutoFlow AI] Validating Human Approval Token: &quot; + in_ApprovalToken + &quot; signed by: &quot; + in_ApprovedBy]" />
    <If Condition="[String.IsNullOrEmpty(in_ApprovalToken)]" DisplayName="Assert Approval Exists">
      <If.Then>
        <Throw Exception="[New System.Security.SecurityException(&quot;UiPath Robot Execution Halted: Human Approval Token Missing for Invoice Entry.&quot;)]" />
      </If.Then>
    </If>
    <Assign DisplayName="Generate Ledger Voucher">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[voucherRef]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">["VOUCHER-AP-" + System.Guid.NewGuid().ToString().Substring(0,6).ToUpper()]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:LogMessage Level="Info" Message="[&quot;Posting to SAP/ERP Accounts Payable: Vendor=&quot; + in_VendorName + &quot;, Invoice=&quot; + in_InvoiceNumber + &quot;, Total=&quot; + in_TotalAmount.ToString()]" />
    <Assign DisplayName="Set Output Voucher">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_VoucherNumber]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[voucherRef]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Set Out Status">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_Status]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">["POSTED_SUCCESSFULLY"]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:LogMessage Level="Info" Message="[&quot;Invoice successfully committed to financial ledger. Voucher: &quot; + voucherRef]" />
  </Sequence>
</Activity>
